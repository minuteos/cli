<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MinuteOS.Debug</RootNamespace>
    <Description>The minuteOS debug engine: GDB/MI, probe/server drivers, and a Debug Adapter Protocol server (minuteos dap).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinuteOS.Build\MinuteOS.Build.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="LibUsbDotNet" Version="3.0.224" />
  </ItemGroup>

  <!-- Renode plugin peripherals: C# compiled *by Renode* at runtime (monitor
       `i @file`), not by this project - shipped as embedded text. -->
  <ItemGroup>
    <Compile Remove="Renode\Plugins\**" />
    <EmbeddedResource Include="Renode\Plugins\*.cs" />
  </ItemGroup>

  <!-- Embedded native libusb (official per-platform builds) so single-file /
       AOT builds carry it; extracted + loaded at runtime by
       EmbeddedNativeLibrary (logical name MinuteOS.Debug.native.<rid>.<file>).
       The binaries are NOT committed - CI fetches each platform's official
       libusb into native/<rid>/ before publish (see eng/fetch-libusb.sh and
       .github/workflows/aot.yml), so a normal clone builds with none embedded
       and the loader falls back to a system libusb. Each entry is conditional
       so only what CI placed is embedded (a per-RID publish only needs its own).
       WithCulture=false: the ".so" in the Linux name is otherwise misread as the
       Somali culture code and routed to a satellite assembly. Linux still needs
       system libudev/libcap at load time (present on any systemd host). -->
  <ItemGroup>
    <None Remove="native/**/*" />
    <EmbeddedResource Include="native/linux-x64/libusb-1.0.so.0" Condition="Exists('native/linux-x64/libusb-1.0.so.0')"
                      LogicalName="MinuteOS.Debug.native.linux-x64.libusb-1.0.so.0" WithCulture="false" />
    <EmbeddedResource Include="native/linux-arm64/libusb-1.0.so.0" Condition="Exists('native/linux-arm64/libusb-1.0.so.0')"
                      LogicalName="MinuteOS.Debug.native.linux-arm64.libusb-1.0.so.0" WithCulture="false" />
    <EmbeddedResource Include="native/win-x64/libusb-1.0.dll" Condition="Exists('native/win-x64/libusb-1.0.dll')"
                      LogicalName="MinuteOS.Debug.native.win-x64.libusb-1.0.dll" WithCulture="false" />
    <EmbeddedResource Include="native/win-arm64/libusb-1.0.dll" Condition="Exists('native/win-arm64/libusb-1.0.dll')"
                      LogicalName="MinuteOS.Debug.native.win-arm64.libusb-1.0.dll" WithCulture="false" />
    <EmbeddedResource Include="native/osx-x64/libusb-1.0.dylib" Condition="Exists('native/osx-x64/libusb-1.0.dylib')"
                      LogicalName="MinuteOS.Debug.native.osx-x64.libusb-1.0.dylib" WithCulture="false" />
    <EmbeddedResource Include="native/osx-arm64/libusb-1.0.dylib" Condition="Exists('native/osx-arm64/libusb-1.0.dylib')"
                      LogicalName="MinuteOS.Debug.native.osx-arm64.libusb-1.0.dylib" WithCulture="false" />
  </ItemGroup>

</Project>
