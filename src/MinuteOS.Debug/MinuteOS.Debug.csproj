<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MinuteOS.Debug</RootNamespace>
    <Description>The minuteOS debug engine: GDB/MI, probe/server drivers, and a Debug Adapter Protocol server (minuteos dap).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinuteOS.Build\MinuteOS.Build.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="LibUsbDotNet" Version="3.0.224" />
  </ItemGroup>

  <!-- Renode plugin peripherals: C# compiled *by Renode* at runtime (monitor
       `i @file`), not by this project - shipped as embedded text. -->
  <ItemGroup>
    <Compile Remove="Renode\Plugins\**" />
    <EmbeddedResource Include="Renode\Plugins\*.cs" />
  </ItemGroup>

  <!-- Embedded native libusb (udev-free, per-RID) so single-file / AOT builds
       carry it; extracted + loaded at runtime by EmbeddedNativeLibrary. Logical
       name: MinuteOS.Debug.native.<rid>.<file>. One entry per platform binary. -->
  <ItemGroup>
    <None Remove="native/**/*" />
    <!-- WithCulture=false: the ".so" in the filename is otherwise misread as the
         Somali culture code and routed to a satellite assembly. -->
    <EmbeddedResource Include="native/linux-x64/libusb-1.0.so.0"
                      LogicalName="MinuteOS.Debug.native.linux-x64.libusb-1.0.so.0" WithCulture="false" />
  </ItemGroup>

</Project>
