<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MinuteOS.Cli</RootNamespace>
    <AssemblyName>minuteos</AssemblyName>

    <!-- Ship as a dotnet global tool by default. A native AOT publish
         (`dotnet publish -r <rid> -p:PublishAot=true`) produces a
         self-contained native binary instead; the two are mutually exclusive,
         so PackAsTool is suppressed for AOT. The command framework
         (triaxis.CommandLine, source-gen) and config loading (YamlDotNet static
         context) are both reflection-free, so AOT needs no per-command work. -->
    <PackAsTool Condition="'$(PublishAot)' != 'true'">true</PackAsTool>
    <ToolCommandName>minuteos</ToolCommandName>
    <PackageId>minuteos</PackageId>
    <Version>0.1.0</Version>
    <Description>CLI for managing minuteos projects: build, test, and scaffold.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="triaxis.CommandLine.Tool" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinuteOS.Build\MinuteOS.Build.csproj" />
    <ProjectReference Include="..\MinuteOS.Debug\MinuteOS.Debug.csproj" />
  </ItemGroup>

</Project>
