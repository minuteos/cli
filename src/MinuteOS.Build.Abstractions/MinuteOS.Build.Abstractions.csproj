<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MinuteOS.Build</RootNamespace>
    <AssemblyName>MinuteOS.Build.Abstractions</AssemblyName>
    <Description>Contracts for the minuteOS build system: the step-authoring surface (artifacts, steps, actions) and the consumer entry points. Reference this to write a build step or drive a build.</Description>
